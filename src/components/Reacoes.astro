---
// Curtir e compartilhar, no fim do texto de cada peça. Curtir não mostra número (só a equipe vê, no painel).
// Botões do mesmo tamanho: 2 por linha no celular (se sobrar um, ele ocupa a linha toda), todos numa linha no computador.
// O comportamento fica em public/reacoes.js; sem JavaScript, sobra o botão de WhatsApp.
import { t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';

interface Props {
  idioma: Idioma;
  pecaId: string;
  titulo: string;
}
const { idioma, pecaId, titulo } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const texto = `${textoManchete(titulo)} ${url}`;
---
<div class="reacoes" data-reacoes data-peca={pecaId} data-url={url} data-titulo={textoManchete(titulo)}>
  <button type="button" class="reacoes__botao maquina" data-curtir aria-pressed="false" hidden>
    <svg class="reacoes__icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.6-9.3A5.2 5.2 0 0 1 12 6.4a5.2 5.2 0 0 1 9.6 4.8C19.5 15.9 12 20.5 12 20.5z" /></svg>
    <span data-rotulo>{t(idioma, 'reacoes.curtir')}</span><span data-feito hidden>{t(idioma, 'reacoes.curtiu')}</span>
  </button>
  <button type="button" class="reacoes__botao maquina" data-compartilhar hidden>
    <svg class="reacoes__icone" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" /><path d="M8.3 13.3l7.4 4.4M15.7 6.3l-7.4 4.4" /></svg>
    <span>{t(idioma, 'reacoes.compartilhar')}</span>
  </button>
  <a class="reacoes__botao maquina" href={`https://wa.me/?text=${encodeURIComponent(texto)}`} rel="noopener">
    <svg class="reacoes__icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5l1.3-4.3a8.5 8.5 0 1 1 3.2 3z" /><path d="M9 8.6c0 3.4 3 6.4 6.4 6.4l.9-1.6-2-1-1 .9c-1-.5-2-1.5-2.5-2.5l.9-1-1-2z" /></svg>
    <span>{t(idioma, 'reacoes.whatsapp')}</span>
  </a>
  <button type="button" class="reacoes__botao maquina" data-copiar hidden>
    <svg class="reacoes__icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
    <span data-rotulo>{t(idioma, 'reacoes.copiar')}</span><span data-feito hidden>{t(idioma, 'reacoes.copiado')}</span>
  </button>
</div>
<script is:inline src="/reacoes.js" defer></script>

<style>
  .reacoes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--esp-2);
    margin: var(--esp-6) 0;
  }
  /* Número ímpar de botões: o último ocupa a linha inteira, com o texto no meio. */
  .reacoes > :last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .reacoes {
      grid-template-columns: repeat(var(--botoes, 4), minmax(0, 1fr));
    }
    .reacoes > :last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
  .reacoes__botao {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: 52px;
    padding: 0 var(--esp-3);
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }
  .reacoes__icone {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .reacoes__botao:hover,
  .reacoes__botao:focus-visible {
    background: var(--tinta);
    color: var(--cal);
  }
  .reacoes__botao[data-curtir][aria-pressed='true'] {
    background: var(--pau-brasil);
    border-color: var(--pau-brasil);
    color: var(--cal);
  }
  .reacoes__botao[data-curtir][aria-pressed='true'] .reacoes__icone {
    fill: currentColor;
  }
</style>
