---
// Manchete da identidade: cada | do autor vira uma linha; *trecho* sai em destaque.
// Sem marcação, o navegador equilibra as linhas (text-wrap: balance) para não sobrar palavra órfã.
import { linhasManchete } from '../../lib/manchete';

interface Props {
  titulo: string;
  tamanho?: 'g' | 'm';
  nivel?: 1 | 2;
  id?: string;
  // Texto corrido: ignora as quebras do | e deixa o navegador quebrar a linha. 'celular' só em tela estreita.
  corrida?: 'celular' | 'sempre';
}
const { titulo, tamanho = 'g', nivel = 1, id, corrida } = Astro.props;
const linhas = linhasManchete(titulo);
const Tag = nivel === 1 ? 'h1' : 'h2';
---
<Tag id={id} class:list={['manchete', `manchete--${tamanho}`, corrida && `manchete--corrida-${corrida}`]}>
  {linhas.map((linha) => (
    <span class="manchete__linha">
      {linha.map((t) => (t.destaque ? <span class="manchete__destaque">{t.texto}</span> : t.texto))}
    </span>
  ))}
</Tag>

<style>
  .manchete__linha {
    display: block;
    text-wrap: balance;
  }
  /* g: manchete da capa; m: manchete de página e de matéria (escala em tokens.css). */
  .manchete--g {
    font-size: var(--tipo-display);
  }
  .manchete--m {
    font-size: var(--tipo-titulo);
  }
  .manchete--corrida-sempre .manchete__linha {
    display: inline;
  }
  .manchete--corrida-sempre .manchete__linha + .manchete__linha::before {
    content: ' ';
  }
  @media (max-width: 899px) {
    .manchete--corrida-celular .manchete__linha {
      display: inline;
    }
    .manchete--corrida-celular .manchete__linha + .manchete__linha::before {
      content: ' ';
    }
  }
  /* inline-block: o fundo fica do tamanho da linha e não cobre a linha de cima. */
  .manchete__destaque {
    display: inline-block;
    color: var(--destaque-texto);
    background: var(--destaque-fundo);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 var(--destaque-recuo);
    margin-left: calc(-1 * var(--destaque-recuo));
  }
</style>
