---
// Esqueleto fixo: selo de editoria sempre no canto superior direito. A Tarja fica no menu.
import Selo from '../identidade/Selo.astro';

interface Props {
  selo?: string;
}
const { selo } = Astro.props;
---
{selo && (
  <header class="cabecalho">
    <Selo texto={selo} />
  </header>
)}

<style>
  .cabecalho {
    display: flex;
    justify-content: flex-end;
    padding: var(--esp-5) var(--esp-4) 0;
    max-width: 960px;
    margin: 0 auto;
  }
</style>
