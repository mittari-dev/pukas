---
// Assinatura fixa do rodapé (manual v2.0 §2).
import { prefixar, t, type Idioma } from '../../lib/idioma';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
---
<footer class="rodape maquina">
  <span>{t(idioma, 'site.assinatura')}</span>
  <nav aria-label="Rodapé">
    <a href={prefixar('/rss.xml', idioma)}>RSS</a>
    <a href="/admin" class="rodape__painel" aria-label="Painel" title="Painel">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="5" stroke-dasharray="3.14 3.14" />
        <circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
    </a>
  </nav>
</footer>

<style>
  .rodape {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--esp-3);
    max-width: 960px;
    margin: var(--esp-8) auto 0;
    padding: var(--esp-4);
    border-top: 3px solid currentColor;
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  /* Mesmo quebrando linha no celular, RSS e a engrenagem ficam no canto direito. */
  .rodape nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--esp-4);
  }
  .rodape a {
    display: inline-block;
    padding: var(--esp-2) 0;
    text-transform: uppercase;
  }
  /* Engrenagem discreta no canto, para o painel. O /admin pede senha e 2FA; o link sozinho não abre nada. */
  /* .rodape a (inline-block) ganharia de .rodape__painel sozinho: por isso o seletor duplo. */
  .rodape .rodape__painel {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-right: calc(-1 * var(--esp-3));
  }
  .rodape .rodape__painel svg {
    display: block;
  }
</style>
