---
// Barra do topo (Tarja no canto superior esquerdo) + menu-gaveta que abre e fecha em qualquer tela.
// <details>/<summary>: abre e fecha sem JavaScript, e o leitor de tela anuncia aberto/fechado.
// O script no fim só acrescenta fechar ao clicar fora e com Esc.
import Tarja from '../identidade/Tarja.astro';
import Setas from './Setas.astro';
import { navegacao } from '../../data/navegacao';
import { secaoAtiva } from '../../lib/navegacao';
import { prefixar, semPrefixo, t, type Idioma } from '../../lib/idioma';

interface Props {
  // Sobre fundo Pau-Brasil (Agitação) a Tarja vermelha sumiria: usa a versão em Tinta.
  tarja?: 'cor' | 'tinta';
  idioma: Idioma;
  // Mesma página no outro idioma (ou o índice da seção, se não houver tradução).
  alternativa: string;
}
const { tarja = 'cor', idioma, alternativa } = Astro.props;
const itens = navegacao.map((i) => ({ rotulo: t(idioma, i.chave), href: i.href }));
const ativa = secaoAtiva(semPrefixo(Astro.url.pathname).caminho, itens);
const outro: Idioma = idioma === 'pt' ? 'es' : 'pt';
// ?idioma= faz o middleware lembrar a escolha (cookie) antes de abrir a página.
const seletor = { pt: idioma === 'pt' ? undefined : `${alternativa}?idioma=pt`, es: idioma === 'es' ? undefined : `${alternativa}?idioma=es` };
---
<header class="barra">
  <details class="menu">
    <summary class="menu__botao">
      <span class="sr-only">{t(idioma, 'nav.menu')}</span>
      <svg class="icone icone--abrir" width="28" height="22" viewBox="0 0 28 22" aria-hidden="true" focusable="false">
        <rect y="0" width="28" height="4" fill="currentColor"></rect>
        <rect y="9" width="28" height="4" fill="currentColor"></rect>
        <rect y="18" width="28" height="4" fill="currentColor"></rect>
      </svg>
      <svg class="icone icone--fechar" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 3 L21 21 M21 3 L3 21" stroke="currentColor" stroke-width="4"></path>
      </svg>
    </summary>
    <nav class="gaveta" aria-label={t(idioma, 'nav.secoes')}>
      <ul class="itens">
        {itens.map((i) => (
          <li><a href={prefixar(i.href, idioma)} aria-current={i.href === ativa ? 'page' : undefined}>{i.rotulo}</a></li>
        ))}
      </ul>
    </nav>
  </details>
  <a href={prefixar('/', idioma)} class="marca"><Tarja variante={tarja} rotulo={t(idioma, 'nav.marca')} /></a>
  <nav class="topo maquina" aria-label={t(idioma, 'nav.secoes')}>
    {itens.filter((i) => i.href !== '/' && i.href !== '/links').map((i) => (
      <a href={prefixar(i.href, idioma)} aria-current={i.href === ativa ? 'page' : undefined}>{i.rotulo}</a>
    ))}
  </nav>
  <Setas voltar={t(idioma, 'nav.voltar')} avancar={t(idioma, 'nav.avancar')} />
  <nav class="idiomas maquina" aria-label={t(idioma, 'nav.idioma')}>
    {seletor.pt ? <a href={seletor.pt} hreflang="pt-BR" lang="pt-BR">PT</a> : <span aria-current="true">PT</span>}
    <span aria-hidden="true">|</span>
    {seletor.es ? <a href={seletor.es} hreflang="es-419" lang="es-419">ES</a> : <span aria-current="true">ES</span>}
  </nav>
</header>

<script>
  // Fecha a gaveta ao clicar fora dela ou apertar Esc. Sem este script, o <details> continua abrindo e fechando pelo botão.
  const menu = document.querySelector<HTMLDetailsElement>('.barra .menu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* Fica presa no topo enquanto a pessoa lê. */
  .barra {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--fundo);
    display: flex;
    align-items: center;
    gap: var(--esp-4);
    padding: var(--esp-3) var(--esp-4);
    border-bottom: 2px solid currentColor;
  }
  .marca {
    text-decoration: none;
    line-height: 0;
  }
  .marca :global(.tarja) {
    font-size: clamp(30px, 8vw, 44px);
  }

  /* Computador: as seções à vista na barra; a gaveta continua para quem preferir. */
  .topo {
    display: none;
  }
  @media (min-width: 1024px) {
    .topo {
      display: flex;
      gap: var(--esp-5);
      margin-left: auto;
      font-size: 13px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .topo a {
      text-decoration: none;
      padding: var(--esp-2) 0;
    }
    .topo a:hover,
    .topo a:focus-visible,
    .topo a[aria-current='page'] {
      color: var(--ativo);
    }
    .topo a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
    .barra :global(.setas) {
      margin-left: var(--esp-3);
    }
  }

  /* Celular: menu, Tarja, setas e PT | ES precisam caber numa linha de 360px. */
  @media (max-width: 600px) {
    .barra {
      gap: var(--esp-2);
      padding: var(--esp-3);
    }
    .menu__botao {
      width: 44px;
    }
    .barra :global(.setas__botao) {
      width: 32px;
    }
    .idiomas {
      gap: 0;
    }
    .idiomas a,
    .idiomas [aria-current] {
      min-width: 28px;
    }
  }
  /* Tela muito estreita: o voltar do próprio celular basta. */
  @media (max-width: 350px) {
    .barra :global(.setas) {
      display: none;
    }
  }

  .barra :global(.setas) {
    margin-left: auto;
  }
  .idiomas {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    font-size: 15px;
    letter-spacing: 0.08em;
  }
  .idiomas a,
  .idiomas [aria-current] {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
  }
  .idiomas a {
    text-decoration: none;
    opacity: 0.75;
  }
  .idiomas a:hover,
  .idiomas a:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }
  .idiomas [aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
  .menu__botao {
    list-style: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    cursor: pointer;
  }
  .menu__botao::-webkit-details-marker {
    display: none;
  }
  .icone--fechar,
  .menu[open] .icone--abrir {
    display: none;
  }
  .menu[open] .icone--fechar {
    display: block;
  }

  /* Gaveta: entra pela esquerda, embaixo da barra. Celular: tela cheia. Computador: 360px. */
  .gaveta {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    width: 100%;
    min-height: 100vh;
    padding: var(--esp-6) var(--esp-4);
    background: var(--fundo);
    border-right: 3px solid currentColor;
  }
  @media (min-width: 768px) {
    .gaveta {
      width: 360px;
      padding: var(--esp-6);
    }
  }

  .itens {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .itens a {
    display: block;
    padding: var(--esp-3) 0;
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: 40px;
    line-height: 0.95;
    text-transform: uppercase;
    text-decoration: none;
  }
  .itens a:hover,
  .itens a:focus-visible,
  .itens a[aria-current='page'] {
    color: var(--ativo);
  }
  .itens a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
  /* "/ ''" esconde o marcador do leitor de tela; aria-current já anuncia a página. */
  .itens a[aria-current='page']::before {
    content: '› ' / '';
  }
</style>
