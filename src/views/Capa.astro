---
// Capa (Home A, escolhida pelo fundador em 08/11/2026, enxugada no mesmo dia): a frase fixa no topo e a última
// newsletter ao lado; depois a votação aberta, as notícias em cartões (foto inteira em cima) e um bloco só para assinar.
// No celular tudo vira uma coluna, nessa ordem.
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import FormAssinar from '../components/FormAssinar.astro';
import CartaoNoticia from '../components/CartaoNoticia.astro';
import { imagem, srcset } from '../lib/imagem';
import { carregarEdicoes, carregarNoticias, carregarSeries, carregarVotacoes } from '../lib/carregar';
import { caminhoEdicao, formatarData, formatarNumero } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import { OPCOES, type Opcao } from '../lib/votacoes/voto';
import type { Chave } from '../i18n/textos';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const [edicoes, noticias, { abertas }, series] = await Promise.all([carregarEdicoes(idioma), carregarNoticias(idioma), carregarVotacoes(idioma), carregarSeries(idioma)]);
const votacao = abertas[0];
const ultima = edicoes[0];
// Pode haver mais de uma newsletter: o cartão diz de qual série é a última edição.
const nomeSerie = ultima ? (series.find((x) => x.slug === ultima.data.serie)?.nome ?? '') : '';
const ROTULO: Record<Opcao, Chave> = { a_favor: 'votacao.afavor', contra: 'votacao.contra', nao_sei: 'votacao.naosei' };
const ICONE: Record<Opcao, string> = { a_favor: 'M4 12.5l5 5L20 6.5', contra: 'M6 6l12 12M18 6L6 18', nao_sei: 'M9 9a3 3 0 1 1 4.2 2.8c-.8.4-1.2 1-1.2 1.8V15M12 18.5v.5' };
---
<Base titulo="PUKAS" descricao={t(idioma, 'site.descricao')} receita="leitura" idioma={idioma}>
  <div class="capa">
    <section class="topo">
      <div class="topo__frase"><Manchete titulo={t(idioma, 'capa.manchete')} corrida="celular" /></div>
      {ultima ? (
        <a class="ultima" href={caminhoEdicao(ultima.data.serie, ultima.data.numero, idioma)}>
          <span class="maquina ultima__chapeu">{nomeSerie ? `${nomeSerie} · ` : ''}{t(idioma, 'capa.ultimaEdicao')}</span>
          {ultima.data.foto.arquivo && <img class="ultima__foto" src={imagem(ultima.data.foto.arquivo as string, 800)} srcset={srcset(ultima.data.foto.arquivo as string)} sizes="(min-width: 900px) 460px, 100vw" alt={ultima.data.foto.descricao} width="800" height="450" loading="eager" decoding="async" fetchpriority="high" />}
          <span class="maquina ultima__meta">{formatarNumero(ultima.data.numero)} · {formatarData(ultima.data.publicadaEm, idioma)}</span>
          <span class="ultima__titulo">{textoManchete(ultima.data.titulo)}</span>
          <span class="ultima__resumo">{ultima.data.resumo}</span>
          <span class="maquina ultima__ler">{t(idioma, 'capa.lerEdicao')} →</span>
        </a>
      ) : (
        <p class="topo__vazio">{t(idioma, 'serie.vazio')}</p>
      )}
    </section>

    {votacao && (
      <section class="votacao" aria-labelledby="votacao-titulo">
        <div class="votacao__texto">
          <span class="maquina votacao__meta">
            {t(idioma, 'capa.votacao')} · {votacao.proposicao.sigla} {votacao.proposicao.numero}/{votacao.proposicao.ano}{votacao.fechaEm && <> · {t(idioma, 'votacao.fecha')} {formatarData(votacao.fechaEm, idioma)}</>}
          </span>
          <a id="votacao-titulo" class="votacao__titulo" href={prefixar(`/votacoes/${votacao.id}`, idioma)}>{textoManchete(votacao.titulo)}</a>
          <span class="votacao__resumo">{votacao.resumo}</span>
        </div>
        <div class="votacao__opcoes">
          {OPCOES.map((o) => (
            <a class="maquina votacao__opcao" href={prefixar(`/votacoes/${votacao.id}#votar`, idioma)}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONE[o]} /></svg>
              {t(idioma, ROTULO[o])}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="secao noticias" aria-labelledby="sec-noticias">
      <div class="secao__cabeca">
        <h2 id="sec-noticias" class="secao__titulo">{t(idioma, 'capa.noticias')}</h2>
        <a class="maquina secao__mais" href={prefixar('/noticias', idioma)}>{t(idioma, 'capa.verNoticias')} →</a>
      </div>
      {noticias.length === 0 ? (
        <p class="secao__vazio">{t(idioma, 'capa.semNoticias')}</p>
      ) : (
        <ul class="cartoes cartoes--3">
          {noticias.slice(0, 6).map((n) => (
            <li>
              <CartaoNoticia href={prefixar(`/noticias/${n.id}`, idioma)} foto={(n.data.foto.arquivo as string) || undefined} meta={formatarData(n.data.publicadaEm, idioma)} titulo={textoManchete(n.data.titulo)} resumo={n.data.resumo} />
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="assinar" aria-labelledby="assinar-titulo">
      <div class="assinar__texto">
        <h2 id="assinar-titulo" class="assinar__titulo">{t(idioma, 'capa.assinarTitulo')}</h2>
        <p class="assinar__sub">{t(idioma, 'capa.assinarTexto')}</p>
      </div>
      <FormAssinar idioma={idioma} escuro />
    </section>

    <p class="expediente">
      {t(idioma, 'site.institucional')} <a href={prefixar('/manifesto', idioma)}>{t(idioma, 'site.leiaManifesto')}</a>.
    </p>
  </div>
</Base>

<style>
  .capa {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--esp-6) var(--esp-4) 0;
  }
  @media (min-width: 900px) {
    .capa {
      padding: var(--esp-8) var(--esp-8) 0;
    }
  }

  /* Topo: frase fixa e, ao lado (embaixo no celular), a última edição. */
  .topo {
    display: grid;
    gap: var(--esp-6);
    align-items: end;
  }
  @media (min-width: 900px) {
    .topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--esp-8);
    }
  }
  .topo__frase :global(.manchete) {
    font-size: clamp(52px, 14vw, 124px);
  }
  .topo__vazio {
    margin: 0;
    font-size: var(--tipo-resumo);
  }
  .ultima {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    padding: var(--esp-4);
    border: 2px solid currentColor;
    text-decoration: none;
  }
  .ultima__chapeu {
    text-transform: uppercase;
    font-size: var(--tipo-meta);
    letter-spacing: 0.12em;
    color: var(--acento);
  }
  .ultima__foto {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .ultima__meta {
    text-transform: uppercase;
    font-size: var(--tipo-meta);
    letter-spacing: 0.08em;
    color: var(--suave);
  }
  .ultima__titulo {
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: clamp(28px, 7vw, 36px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .ultima__resumo {
    font-size: var(--tipo-resumo);
    line-height: 1.5;
  }
  .ultima__ler {
    font-size: 13px;
    letter-spacing: 0.12em;
  }
  .ultima:hover .ultima__titulo,
  .ultima:focus-visible .ultima__titulo {
    color: var(--acento);
  }

  /* Votação aberta: faixa vermelha com as três opções. */
  .votacao {
    display: grid;
    gap: var(--esp-5);
    margin-top: var(--esp-7);
    padding: var(--esp-5) var(--esp-4);
    background: var(--pau-brasil);
    color: var(--cal);
  }
  @media (min-width: 900px) {
    .votacao {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--esp-7);
      padding: var(--esp-6) var(--esp-7);
    }
  }
  .votacao__texto {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .votacao__meta {
    text-transform: uppercase;
    font-size: var(--tipo-meta);
    letter-spacing: 0.1em;
  }
  .votacao__titulo {
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: clamp(30px, 7vw, 44px);
    line-height: 0.95;
    text-transform: uppercase;
    text-decoration: none;
  }
  .votacao__resumo {
    font-size: var(--tipo-resumo);
    line-height: 1.5;
    max-width: 640px;
  }
  .votacao__opcoes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--esp-2);
  }
  @media (min-width: 900px) {
    .votacao__opcoes {
      grid-template-columns: repeat(3, 112px);
    }
  }
  .votacao__opcao {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--esp-1);
    min-height: 76px;
    border: 2px solid currentColor;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
  }
  .votacao__opcao:hover,
  .votacao__opcao:focus-visible {
    background: var(--cal);
    color: var(--pau-brasil);
  }
  .votacao__opcao svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Notícias: um título só e cartões com a foto inteira em cima (no celular a miniatura ficava pequena demais). */
  .noticias {
    margin-top: var(--esp-7);
  }
  .secao__cabeca {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--esp-3);
    padding-bottom: var(--esp-3);
    border-bottom: 2px solid currentColor;
  }
  .secao__titulo {
    margin: 0;
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: var(--tipo-secao);
    line-height: 1;
    text-transform: uppercase;
  }
  .secao__mais {
    text-transform: uppercase;
    flex: none;
    font-size: var(--tipo-meta);
    letter-spacing: 0.1em;
  }
  .secao__vazio {
    margin: var(--esp-4) 0 0;
  }

  /* Assinar: bloco próprio, separado das listas. */
  .assinar {
    display: grid;
    gap: var(--esp-5);
    margin-top: var(--esp-7);
    padding: var(--esp-6) var(--esp-4);
    background: var(--tinta);
    color: var(--cal);
  }
  @media (min-width: 900px) {
    .assinar {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--esp-7);
      padding: var(--esp-6) var(--esp-7);
    }
  }
  .assinar__titulo {
    margin: 0;
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: clamp(30px, 7vw, 44px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .assinar__sub {
    margin: var(--esp-2) 0 0;
    font-size: var(--tipo-resumo);
  }

  .expediente {
    max-width: 68ch;
    margin: var(--esp-7) 0 0;
    font-size: 15px;
  }
</style>
