---
import Base from '../layouts/Base.astro';
import CabecaMateria from '../components/CabecaMateria.astro';
import FimMateria from '../components/FimMateria.astro';
import AvisoTraducao from '../components/AvisoTraducao.astro';
import type { ObraIdioma } from '../lib/carregar';
import { formatarData, minutosDeLeitura } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import { renderizarMarkdown } from '../lib/markdown';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
  obra: ObraIdioma;
  alternativa: { href: string; equivalente: boolean };
}
const { idioma, obra, alternativa } = Astro.props;
const d = obra.data;
const poema = d.tipo === 'poema';
// Poema: o verso quebrado com dois espaços vira <br> mais a quebra de linha; com pre-line, os dois somavam uma linha em branco.
const html = await renderizarMarkdown(obra.body ?? '');
const corpo = poema ? html.replace(/<br \/>\n/g, '<br />') : html;
const capa = d.capa?.arquivo as string | undefined;
---
<Base titulo={textoManchete(d.titulo)} descricao={d.resumo} receita="leitura" selo={t(idioma, 'selo.cultura')} imagem={capa} idioma={idioma} alternativa={alternativa}>
  <article class="leitura">
    <CabecaMateria
      chapeu={`${t(idioma, 'capa.cultura')} · ${t(idioma, `tipo.${d.tipo}`)}`}
      titulo={d.titulo}
      linhaFina={d.resumo}
      meta={[`${t(idioma, 'materia.por')} ${d.autoria.toUpperCase()}`, formatarData(d.publicadaEm, idioma), poema ? '' : t(idioma, 'materia.minutos').replace('{n}', String(minutosDeLeitura(obra.body ?? '')))]}
    />
    <AvisoTraducao idioma={idioma} traducao={obra.traducao} original={`/cultura/${obra.id}`} />

    {d.aviso && (
      <p class="obra__aviso" role="note"><span class="maquina">{t(idioma, 'cultura.aviso')}</span> {d.aviso}</p>
    )}

    {d.video && (
      <p class="obra__video"><a class="maquina" href={d.video}>{t(idioma, 'cultura.video')}</a></p>
    )}

    {capa && d.capa && (
      <figure class="obra__capa">
        <img src={capa} alt={d.capa.descricao} width="680" loading="lazy" decoding="async" />
        <figcaption class="maquina">{t(idioma, 'cultura.imagem')}: {d.capa.credito} · {d.capa.licenca}</figcaption>
      </figure>
    )}

    <div class:list={['corpo', { 'corpo--poema': d.tipo === 'poema' }]} set:html={corpo} />

    <FimMateria idioma={idioma} pecaId={obra.pecaId} titulo={d.titulo} fontes={d.fontes} />

    <p class="maquina obra__todas"><a href={prefixar('/cultura', idioma)}>{t(idioma, 'cultura.todas')}</a></p>
  </article>
</Base>

<style>
  .obra__aviso {
    padding: var(--esp-3) var(--esp-4);
    border: 3px solid currentColor;
    font-size: 16px;
  }
  .obra__video a {
    display: inline-block;
    padding: var(--esp-3) var(--esp-4);
    background: var(--tinta);
    color: var(--cal);
    text-decoration: none;
    letter-spacing: 0.08em;
  }
  .obra__capa {
    margin: var(--esp-5) 0;
  }
  .obra__capa figcaption {
    margin-top: var(--esp-2);
    font-size: 12px;
  }
  /* Poema: respeita as quebras do autor, com versos juntos e estrofes separadas; sem capitular. */
  .corpo--poema :global(p) {
    white-space: pre-line;
    font-size: clamp(19px, 1rem + 0.4vw, 21px);
    line-height: 1.5;
  }
  .corpo--poema :global(p + p) {
    margin-top: 1.4em;
  }
  .corpo--poema :global(p:first-child::first-letter) {
    float: none;
    font: inherit;
    color: inherit;
    margin: 0;
  }
  .obra__todas {
    margin-top: var(--esp-6);
    padding-top: var(--esp-3);
    border-top: 2px solid currentColor;
    font-size: 13px;
  }
</style>
