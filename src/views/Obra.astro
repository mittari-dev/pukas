---
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import Carimbo from '../components/identidade/Carimbo.astro';
import AvisoTraducao from '../components/AvisoTraducao.astro';
import type { ObraIdioma } from '../lib/carregar';
import Reacoes from '../components/Reacoes.astro';
import { ordenarFontes } from '../lib/edicoes';
import { formatarData } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import { renderizarMarkdown } from '../lib/markdown';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
  obra: ObraIdioma;
  alternativa: { href: string; equivalente: boolean };
}
const { idioma, obra, alternativa } = Astro.props;
const d = obra.data;
const corpo = await renderizarMarkdown(obra.body ?? '');
const capa = d.capa?.arquivo as string | undefined;
---
<Base titulo={textoManchete(d.titulo)} descricao={d.resumo} receita="leitura" selo={t(idioma, 'selo.cultura')} imagem={capa} idioma={idioma} alternativa={alternativa}>
  <article class="leitura">
    <div class="obra__carimbo"><Carimbo numero={d.numero} data={d.publicadaEm} /></div>
    <AvisoTraducao idioma={idioma} traducao={obra.traducao} original={`/cultura/${obra.id}`} />
    <p class="chapeu obra__tipo">{t(idioma, `tipo.${d.tipo}`)} · {d.autoria.toUpperCase()}</p>
    <div class="obra__titulo"><Manchete titulo={d.titulo} tamanho="m" /></div>

    {d.aviso && (
      <p class="obra__aviso" role="note"><span class="maquina">{t(idioma, 'cultura.aviso')}</span> {d.aviso}</p>
    )}

    {d.video && (
      <p class="obra__video"><a class="maquina" href={d.video}>{t(idioma, 'cultura.video')}</a></p>
    )}

    {capa && d.capa && (
      <figure class="obra__capa">
        <img src={capa} alt={d.capa.descricao} width="680" loading="lazy" decoding="async" />
        <figcaption class="maquina">{t(idioma, 'cultura.imagem')}: {d.capa.credito} · {d.capa.licenca}</figcaption>
      </figure>
    )}

    <div class:list={['corpo', { 'corpo--poema': d.tipo === 'poema' }]} set:html={corpo} />
    {obra.pecaId && <Reacoes idioma={idioma} pecaId={obra.pecaId} titulo={d.titulo} />}

    {d.fontes.length > 0 && (
      <section aria-labelledby="fontes">
        <h2 id="fontes" class="secao-titulo maquina">{t(idioma, 'edicao.fontes')}</h2>
        <ol>
          {ordenarFontes(d.fontes).map((f) => (
            <li class="obra__fonte"><a href={f.url || undefined}>{f.titulo}</a> · {f.instituicao} <span class="maquina">· {t(idioma, 'edicao.acessadaEm')} {formatarData(f.acessadaEm, idioma)}</span></li>
          ))}
        </ol>
      </section>
    )}

    <p class="maquina"><a href={prefixar('/cultura', idioma)}>{t(idioma, 'cultura.todas')}</a></p>
  </article>
</Base>

<style>
  .obra__carimbo {
    margin: var(--esp-4) 0 var(--esp-5);
  }
  .obra__tipo {
    font-size: 13px;
    letter-spacing: 0.12em;
  }
  .obra__titulo {
    margin: var(--esp-3) 0 var(--esp-6);
  }
  .obra__aviso {
    padding: var(--esp-3) var(--esp-4);
    border: 3px solid currentColor;
    font-size: 16px;
  }
  .obra__video a {
    display: inline-block;
    padding: var(--esp-3) var(--esp-4);
    background: var(--tinta);
    color: var(--cal);
    text-decoration: none;
    letter-spacing: 0.08em;
  }
  .obra__capa {
    margin: var(--esp-5) 0;
  }
  .obra__capa figcaption {
    margin-top: var(--esp-2);
    font-size: 12px;
  }
  /* Poema: respeita as quebras de linha do autor. */
  .corpo--poema :global(p) {
    white-space: pre-line;
  }
  .obra__fonte {
    margin-bottom: var(--esp-2);
    overflow-wrap: anywhere;
  }
</style>
