---
// Página da bio (Instagram, YouTube, X). Quem chega veio de um vídeo ou post: primeiro o que tem prazo (votação aberta)
// e a última edição, depois assinar por e-mail, as notícias e a cultura mais novas, e por fim os links fixos.
// Tudo entra sozinho conforme se publica. Receita Agitação.
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import FormAssinar from '../components/FormAssinar.astro';
import { carregarEdicoes, carregarNoticias, carregarObras, carregarVotacoes } from '../lib/carregar';
import { caminhoEdicao, formatarData, formatarNumero } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import { links } from '../data/links';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
// O botão diz "Última Memória Operária": a última edição dessa série, não de qualquer uma.
const [[ultima], [obra], noticias, { abertas }] = await Promise.all([carregarEdicoes(idioma, 'memoria-operaria'), carregarObras(idioma), carregarNoticias(idioma), carregarVotacoes(idioma)]);
const votacao = abertas[0];
type Botao = { rotulo: string; href: string; frase?: string };
const antes: Botao[] = [
  ...(votacao
    ? [{ rotulo: `${t(idioma, 'links.votacaoAberta')}${votacao.fechaEm ? ` · ${t(idioma, 'votacao.fecha')} ${formatarData(votacao.fechaEm, idioma)}` : ''}`, href: prefixar(`/votacoes/${votacao.id}`, idioma), frase: textoManchete(votacao.titulo) }]
    : []),
  ...(ultima
    ? [{ rotulo: `${t(idioma, 'links.ultimaEdicao')} ${formatarNumero(ultima.data.numero)}`, href: caminhoEdicao(ultima.data.serie, ultima.data.numero, idioma), frase: textoManchete(ultima.data.titulo) }]
    : []),
];
const depois: Botao[] = [
  ...noticias.slice(0, 3).map((n) => ({ rotulo: `${t(idioma, 'links.noticia')} · ${formatarData(n.data.publicadaEm, idioma)}`, href: prefixar(`/noticias/${n.id}`, idioma), frase: textoManchete(n.data.titulo) })),
  ...(obra ? [{ rotulo: t(idioma, 'links.novoCultura'), href: prefixar(`/cultura/${obra.id}`, idioma), frase: textoManchete(obra.data.titulo) }] : []),
  ...links.map((l) => ({ rotulo: t(idioma, l.chave), href: prefixar(l.href, idioma) })),
];
const numero = (i: number) => String(i + 1).padStart(2, '0');
---
<Base titulo={t(idioma, 'links.titulo')} descricao={t(idioma, 'links.descricao')} receita="agitacao" idioma={idioma}>
  <div class="links">
    <div class="links__manchete"><Manchete titulo={t(idioma, 'links.manchete')} /></div>
    {antes.length > 0 && (
      <ul class="links__lista">
        {antes.map((b, i) => (
          <li>
            <a class="botao" href={b.href}>
              <span class="maquina botao__n">{numero(i)}</span>
              <span class="botao__texto">
                <span class="botao__rotulo">{b.rotulo}</span>
                {b.frase && <span class="botao__frase">{b.frase}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="links__assinar"><FormAssinar idioma={idioma} /></div>
    <ul class="links__lista">
      {depois.map((b, i) => (
        <li>
          <a class="botao" href={b.href}>
            <span class="maquina botao__n">{numero(antes.length + i)}</span>
            <span class="botao__texto">
              <span class="botao__rotulo">{b.rotulo}</span>
              {b.frase && <span class="botao__frase">{b.frase}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .links {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 var(--esp-4);
  }
  .links__manchete {
    margin: var(--esp-5) 0 var(--esp-6);
  }
  .links__assinar {
    margin: var(--esp-5) 0;
    padding: var(--esp-4);
    border: 3px solid currentColor;
  }
  .links__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .botao {
    display: flex;
    align-items: center;
    gap: var(--esp-4);
    min-height: 64px;
    padding: var(--esp-4);
    background: var(--tinta);
    color: var(--cal);
    text-decoration: none;
    border: 3px solid var(--tinta);
  }
  /* Interação seca, sem easing: inverte a cor e "carimba" o botão. */
  .botao:hover,
  .botao:focus-visible {
    background: var(--cal);
    color: var(--tinta);
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--tinta);
  }
  .botao:active {
    transform: none;
    box-shadow: none;
  }
  .botao:focus-visible {
    outline: 3px solid var(--cal);
    outline-offset: 3px;
  }
  .botao__n {
    font-size: 13px;
  }
  .botao__texto {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  .botao__rotulo {
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: 26px;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .botao__frase {
    font-size: 16px;
  }
</style>
