---
import Base from '../layouts/Base.astro';
import CabecaMateria from '../components/CabecaMateria.astro';
import FimMateria from '../components/FimMateria.astro';
import CartaoNoticia from '../components/CartaoNoticia.astro';
import { imagem, srcset } from '../lib/imagem';
import AvisoTraducao from '../components/AvisoTraducao.astro';
import { carregarEdicoes, carregarNoticias, votacaoDaNoticia, type EdicaoIdioma } from '../lib/carregar';
import { caminhoEdicao, formatarData, formatarNumero, minutosDeLeitura } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import { renderizarMarkdown } from '../lib/markdown';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
  noticia: EdicaoIdioma;
  alternativa: { href: string; equivalente: boolean };
}
const { idioma, noticia, alternativa } = Astro.props;
const d = noticia.data;
const corpo = await renderizarMarkdown(noticia.body ?? '');
const foto = d.foto.arquivo as string;
const [votacao, todas, [edicao]] = await Promise.all([votacaoDaNoticia(noticia.pecaId ?? noticia.id, idioma), carregarNoticias(idioma), carregarEdicoes(idioma)]);
// Leia também: as duas notícias mais novas (menos esta) e a última Memória Operária.
const outras = todas.filter((n) => n.id !== noticia.id).slice(0, 2);
---
<Base titulo={textoManchete(d.titulo)} descricao={d.resumo} receita="leitura" imagem={foto || undefined} idioma={idioma} alternativa={alternativa}>
  <article class="leitura">
    <CabecaMateria
      chapeu={t(idioma, 'capa.noticias')}
      titulo={d.titulo}
      linhaFina={d.resumo}
      meta={[formatarData(d.publicadaEm, idioma), t(idioma, 'materia.minutos').replace('{n}', String(minutosDeLeitura(noticia.body ?? '')))]}
    />

    <AvisoTraducao idioma={idioma} traducao={noticia.traducao} original={`/noticias/${noticia.id}`} />

    {foto && (
    <figure class="edicao__foto">
      <img src={imagem(foto, 800)} srcset={srcset(foto)} sizes="(min-width: 720px) 680px, 100vw" alt={d.foto.descricao} width="800" height="450" loading="eager" decoding="async" fetchpriority="high" />
      <figcaption class="maquina">
        {t(idioma, 'edicao.foto')}: {d.foto.origem ? <a href={d.foto.origem}>{d.foto.credito}</a> : d.foto.credito} · {d.foto.licenca}
      </figcaption>
    </figure>
    )}

    <div class="corpo" set:html={corpo} />

    <FimMateria idioma={idioma} pecaId={noticia.pecaId ?? noticia.id} titulo={d.titulo} fontes={d.fontes} checagem={d.checagem} correcoes={d.correcoes}>
      {votacao && (
        <a class="votacao-ligada" href={prefixar(`/votacoes/${votacao.id}`, idioma)}>
          <span class="maquina">{t(idioma, 'noticia.vote')}</span>
          <span class="votacao-ligada__titulo">{textoManchete(votacao.titulo)}</span>
        </a>
      )}
    </FimMateria>

    {(outras.length > 0 || edicao) && (
      <section aria-labelledby="leia-tambem">
        <h2 id="leia-tambem" class="secao-titulo maquina">{t(idioma, 'noticia.leiaTambem')}</h2>
        <ul class="cartoes leia">
          {outras.map((n) => (
            <li>
              <CartaoNoticia href={prefixar(`/noticias/${n.id}`, idioma)} foto={(n.data.foto.arquivo as string) || undefined} meta={formatarData(n.data.publicadaEm, idioma)} titulo={textoManchete(n.data.titulo)} />
            </li>
          ))}
          {edicao && (
            <li>
              <CartaoNoticia href={caminhoEdicao(edicao.data.serie, edicao.data.numero, idioma)} foto={(edicao.data.foto.arquivo as string) || undefined} meta={`${t(idioma, 'capa.memoria')} · ${formatarNumero(edicao.data.numero)}`} titulo={textoManchete(edicao.data.titulo)} />
            </li>
          )}
        </ul>
      </section>
    )}

  </article>
</Base>

<style>
  .votacao-ligada {
    display: grid;
    gap: var(--esp-1);
    border: 3px solid var(--acento);
    padding: var(--esp-4);
    margin: 0 0 var(--esp-5);
    text-decoration: none;
  }
  .votacao-ligada__titulo {
    font-family: var(--fonte-manchete);
    font-weight: 900;
    font-stretch: var(--largura-manchete);
    font-size: 24px;
    line-height: 1;
    text-transform: uppercase;
  }
  .edicao__foto {
    margin: 0 0 var(--esp-5);
  }
  .edicao__foto :global(img) {
    width: 100%;
    filter: grayscale(1);
  }
  figcaption {
    margin-top: var(--esp-2);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  /* Leia também: um cartão embaixo do outro, na largura do texto. */
  .leia {
    grid-template-columns: minmax(0, 1fr);
  }
</style>
