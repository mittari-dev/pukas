---
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import { carregarObras } from '../lib/carregar';
import { formatarData, formatarNumero } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const obras = await carregarObras(idioma);
---
<Base titulo={t(idioma, 'cultura.titulo')} descricao={t(idioma, 'cultura.descricao')} receita="leitura" selo={t(idioma, 'selo.cultura')} idioma={idioma}>
  <div class="leitura">
    <div class="titulo"><Manchete titulo={t(idioma, 'cultura.titulo')} tamanho="m" /></div>
    <p class="sub">{t(idioma, 'cultura.sub')}</p>

    {obras.length === 0 ? (
      <p class="vazio">{t(idioma, 'cultura.vazio')}</p>
    ) : (
      <ol class="lista" reversed>
        {obras.map((o) => (
          <li>
            <a href={prefixar(`/cultura/${o.id}`, idioma)}>
              <span class="maquina lista__meta">{t(idioma, `tipo.${o.data.tipo}`)} · {formatarNumero(o.data.numero)} · {formatarData(o.data.publicadaEm, idioma)}</span>
              <span class="lista__titulo">{textoManchete(o.data.titulo)}</span>
              <span class="lista__resumo">{o.data.resumo}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>

<style>
  .titulo {
    margin-top: var(--esp-5);
  }
  .sub {
    margin: var(--esp-4) 0 var(--esp-6);
  }
</style>
