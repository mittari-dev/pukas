---
// Arquivo de uma série da newsletter: nome, descrição e as edições dela.
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import ListaEdicoes from '../components/ListaEdicoes.astro';
import { carregarEdicoes } from '../lib/carregar';
import type { Idioma } from '../lib/idioma';
import type { Serie } from '../lib/series';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
  serie: Serie;
}
const { idioma, serie } = Astro.props;
const edicoes = await carregarEdicoes(idioma, serie.slug);
---
<Base titulo={serie.nome} descricao={serie.descricao} receita="leitura" selo={serie.selo} idioma={idioma}>
  <div class="leitura">
    <div class="titulo"><Manchete titulo={serie.nome} tamanho="m" /></div>
    {serie.descricao && <p class="sub">{serie.descricao}</p>}
    <ListaEdicoes edicoes={edicoes} />
  </div>
</Base>

<style>
  .titulo {
    margin-top: var(--esp-5);
  }
  .sub {
    margin: var(--esp-4) 0 var(--esp-6);
  }
</style>
