---
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import { t, type Idioma } from '../lib/idioma';
import { carregarPagina } from '../lib/carregar';
import { renderizarMarkdown } from '../lib/markdown';
import '../styles/leitura.css';

// Também serve outras páginas fixas (/privacidade): sem slug, é o manifesto.
interface Props {
  idioma: Idioma;
  slug?: string;
}
const { idioma, slug = 'manifesto' } = Astro.props;
const pagina = await carregarPagina(slug, idioma);
const titulo = slug === 'manifesto' ? t(idioma, 'manifesto.titulo') : (pagina?.titulo ?? '');
const corpo = pagina ? await renderizarMarkdown(pagina.body) : '';
---
<Base titulo={pagina?.titulo ?? titulo} descricao={pagina?.resumo ?? ''} receita="leitura" idioma={idioma}>
  <article class="leitura">
    <div class="titulo"><Manchete titulo={titulo} tamanho="m" /></div>
    {pagina ? <div class="corpo" set:html={corpo} /> : <p class="maquina">{t(idioma, 'manifesto.emBreve')}</p>}
  </article>
</Base>

<style>
  .titulo {
    margin: var(--esp-5) 0 var(--esp-6);
  }
</style>
