---
// /newsletter: assinar por e-mail e todas as edições, da mais nova para a mais velha (cada série tem também o seu arquivo em /newsletter/<série>).
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import FormAssinar from '../components/FormAssinar.astro';
import ListaEdicoes from '../components/ListaEdicoes.astro';
import { carregarEdicoes } from '../lib/carregar';
import { t, type Idioma } from '../lib/idioma';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const edicoes = await carregarEdicoes(idioma);
---
<Base titulo={t(idioma, 'newsletter.titulo')} descricao={t(idioma, 'site.descricao')} receita="leitura" idioma={idioma}>
  <div class="leitura">
    <div class="titulo"><Manchete titulo={t(idioma, 'newsletter.titulo')} tamanho="m" /></div>
    <FormAssinar idioma={idioma} />
    <ListaEdicoes edicoes={edicoes} />
  </div>
</Base>

<style>
  .titulo {
    margin: var(--esp-5) 0 var(--esp-6);
  }
</style>
