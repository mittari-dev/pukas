---
import Base from '../layouts/Base.astro';
import CabecaMateria from '../components/CabecaMateria.astro';
import FimMateria from '../components/FimMateria.astro';
import { imagem, srcset } from '../lib/imagem';
import AvisoTraducao from '../components/AvisoTraducao.astro';
import type { EdicaoIdioma } from '../lib/carregar';
import { caminhoEdicao, formatarData, formatarNumero, minutosDeLeitura } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import { renderizarMarkdown } from '../lib/markdown';
import { carregarSeries } from '../lib/carregar';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
  edicao: EdicaoIdioma;
  seguinte?: EdicaoIdioma;
  anterior?: EdicaoIdioma;
  alternativa: { href: string; equivalente: boolean };
}
const { idioma, edicao, seguinte, anterior, alternativa } = Astro.props;
const d = edicao.data;
const corpo = await renderizarMarkdown(edicao.body ?? '');
const foto = d.foto.arquivo as string;
// A série pode estar desligada: a edição continua no ar, só sem selo.
const selo = (await carregarSeries(idioma)).find((s) => s.slug === d.serie)?.selo ?? '';
---
<Base titulo={textoManchete(d.titulo)} descricao={d.resumo} receita="leitura" selo={selo || undefined} imagem={foto || undefined} idioma={idioma} alternativa={alternativa}>
  <article class="leitura">
    <CabecaMateria
      chapeu={`${(selo || 'Newsletter').replace('*', '')} · ${formatarNumero(d.numero)}`}
      titulo={d.titulo}
      linhaFina={d.resumo}
      meta={[formatarData(d.publicadaEm, idioma), t(idioma, 'materia.minutos').replace('{n}', String(minutosDeLeitura(edicao.body ?? '')))]}
    />

    <AvisoTraducao idioma={idioma} traducao={edicao.traducao} original={caminhoEdicao(d.serie, d.numero)} />

    <figure class="edicao__foto">
      <img src={imagem(foto, 800)} srcset={srcset(foto)} sizes="(min-width: 720px) 680px, 100vw" alt={d.foto.descricao} width="800" height="450" loading="eager" decoding="async" fetchpriority="high" />
      <figcaption class="maquina">
        {t(idioma, 'edicao.foto')}: {d.foto.origem ? <a href={d.foto.origem}>{d.foto.credito}</a> : d.foto.credito} · {d.foto.licenca}
      </figcaption>
    </figure>

    <div class="corpo" set:html={corpo} />

    <FimMateria idioma={idioma} pecaId={edicao.pecaId} titulo={d.titulo} fontes={d.fontes} checagem={d.checagem} correcoes={d.correcoes} />

    <nav class="edicao__nav maquina" aria-label={t(idioma, 'edicao.outras')}>
      {anterior && <a href={caminhoEdicao(anterior.data.serie, anterior.data.numero, idioma)}>‹ {formatarNumero(anterior.data.numero)}</a>}
      <a href={prefixar(`/newsletter/${d.serie}`, idioma)}>{t(idioma, 'edicao.todas')}</a>
      {seguinte && <a href={caminhoEdicao(seguinte.data.serie, seguinte.data.numero, idioma)}>{formatarNumero(seguinte.data.numero)} ›</a>}
    </nav>
  </article>
</Base>

<style>
  .edicao__foto {
    margin: 0 0 var(--esp-5);
  }
  .edicao__foto :global(img) {
    width: 100%;
    filter: grayscale(1);
  }
  figcaption {
    margin-top: var(--esp-2);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  /* Anterior, todas e seguinte: depois da linha grossa, como o fim de um caderno. */
  .edicao__nav {
    margin-top: var(--esp-6);
    padding: var(--esp-2) 0;
    border-top: 2px solid currentColor;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--esp-4);
    font-size: 13px;
  }
  .edicao__nav a {
    display: inline-block;
    padding: var(--esp-3) 0;
  }
</style>
