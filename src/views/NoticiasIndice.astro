---
import Base from '../layouts/Base.astro';
import Manchete from '../components/identidade/Manchete.astro';
import { carregarNoticias } from '../lib/carregar';
import { formatarData } from '../lib/formato';
import { prefixar, t, type Idioma } from '../lib/idioma';
import { textoManchete } from '../lib/manchete';
import '../styles/leitura.css';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const noticias = await carregarNoticias(idioma);
---
<Base titulo={t(idioma, 'noticias.titulo')} descricao={t(idioma, 'noticias.descricao')} receita="leitura" idioma={idioma}>
  <div class="leitura">
    <div class="titulo"><Manchete titulo={t(idioma, 'noticias.titulo')} tamanho="m" /></div>
    <p class="sub">{t(idioma, 'noticias.sub')}</p>

    {noticias.length === 0 ? (
      <p class="vazio">{t(idioma, 'noticias.vazio')}</p>
    ) : (
      <ol class="lista" reversed>
        {noticias.map((o) => (
          <li>
            <a href={prefixar(`/noticias/${o.id}`, idioma)}>
              <span class="maquina lista__meta">{formatarData(o.data.publicadaEm, idioma)}</span>
              <span class="lista__titulo">{textoManchete(o.data.titulo)}</span>
              <span class="lista__resumo">{o.data.resumo}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>

<style>
  .titulo {
    margin-top: var(--esp-5);
  }
  .sub {
    margin: var(--esp-4) 0 var(--esp-6);
  }
</style>
