---
// Casca do painel: mesma identidade (receita Leitura), feito para o celular, fora do Google.
import '../styles/base.css';
import '../styles/leitura.css';
import Tarja from '../components/identidade/Tarja.astro';
import Setas from '../components/layout/Setas.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const usuario = Astro.locals.painel?.usuario;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Painel PUKAS</title>
  </head>
  <body class="receita-leitura">
    <header class="topo">
      <a href="/admin" class="marca"><Tarja variante="cor" rotulo="Painel PUKAS" /></a>
      <span class="maquina topo__rotulo">PAINEL</span>
      <Setas voltar="Voltar" avancar="Avançar" />
      {usuario ? (
        <details class="conta">
          <summary class="conta__botao">
            <span class="sr-only">Menu do painel</span>
            <svg width="26" height="20" viewBox="0 0 26 20" aria-hidden="true" focusable="false">
              <rect y="0" width="26" height="4" fill="currentColor"></rect>
              <rect y="8" width="26" height="4" fill="currentColor"></rect>
              <rect y="16" width="26" height="4" fill="currentColor"></rect>
            </svg>
          </summary>
          <nav class="conta__menu maquina" aria-label="Painel">
            <span class="conta__quem">{usuario.nome || usuario.email} · {usuario.papel.toUpperCase()}</span>
            <a href="/admin">Fila</a>
            {usuario.papel === 'editor' && <a href="/admin/equipe">Equipe</a>}
            <a href="/" target="_blank" rel="noopener">Ver o site ↗</a>
            <form method="post" action="/admin/sair">
              <button class="maquina botao botao--linha" type="submit">Sair</button>
            </form>
          </nav>
        </details>
      ) : (
        <a href="/" class="maquina topo__site">Ver o site</a>
      )}
    </header>
    <script is:inline src="/painel.js" defer></script>
    <main id="conteudo" class="painel">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .painel {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--esp-5) var(--esp-4) var(--esp-8);
  }
  .painel h1 {
    font-family: var(--fonte-manchete);
    font-stretch: var(--largura-manchete);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(36px, 9vw, 56px);
    line-height: 0.95;
    margin: 0 0 var(--esp-5);
  }
  .campo {
    display: grid;
    gap: var(--esp-2);
    margin-bottom: var(--esp-4);
  }
  .campo label,
  .campo legend {
    font-family: var(--fonte-maquina);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .campo input,
  .campo textarea,
  .campo select {
    font: inherit;
    padding: var(--esp-3);
    border: 3px solid var(--tinta);
    background: var(--cal);
    color: var(--tinta);
    min-height: 48px;
    width: 100%;
    box-sizing: border-box;
  }
  .campo textarea {
    min-height: 12rem;
    line-height: 1.5;
  }
  .campo input:focus-visible,
  .campo textarea:focus-visible,
  .campo select:focus-visible {
    outline: 3px solid var(--pau-brasil);
    outline-offset: 2px;
  }
  .ajuda {
    font-size: 14px;
    margin: 0;
  }
  .botao {
    font-family: var(--fonte-maquina);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 48px;
    padding: var(--esp-3) var(--esp-4);
    border: 3px solid var(--tinta);
    background: var(--tinta);
    color: var(--cal);
    cursor: pointer;
  }
  .botao--marca {
    background: var(--pau-brasil);
    border-color: var(--pau-brasil);
  }
  .botao--linha {
    background: transparent;
    color: var(--tinta);
  }
  .botao:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .mensagem {
    border: 3px solid var(--pau-brasil);
    padding: var(--esp-3) var(--esp-4);
    margin: 0 0 var(--esp-5);
  }
</style>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--fundo);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3) var(--esp-4);
    padding: var(--esp-3) var(--esp-4);
    border-bottom: 3px solid currentColor;
  }
  .marca :global(svg),
  .marca :global(.tarja) {
    height: 40px;
  }
  .topo__rotulo {
    font-size: 13px;
    letter-spacing: 0.1em;
  }
  .topo__site,
  .conta {
    margin-left: auto;
  }
  .topo :global(.setas) {
    margin-left: var(--esp-2);
  }
  .conta {
    position: relative;
  }
  .conta__botao {
    list-style: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    cursor: pointer;
  }
  .conta__botao::-webkit-details-marker {
    display: none;
  }
  .conta[open] .conta__botao {
    background: var(--tinta);
    color: var(--cal);
  }
  /* Abre embaixo do botão, alinhado à direita; no celular ocupa quase a largura toda. */
  .conta__menu {
    position: absolute;
    right: 0;
    top: calc(100% + var(--esp-2));
    z-index: 30;
    display: grid;
    width: min(280px, calc(100vw - 2 * var(--esp-3)));
    padding: var(--esp-3);
    background: var(--fundo);
    border: 3px solid var(--tinta);
    font-size: 14px;
  }
  .conta__menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--tinta);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .conta__quem {
    font-size: 12px;
    padding-bottom: var(--esp-2);
    border-bottom: 3px solid var(--tinta);
  }
  .conta__menu form {
    padding-top: var(--esp-3);
  }
  .conta__menu button {
    width: 100%;
  }
  @media (max-width: 600px) {
    .topo {
      flex-wrap: nowrap;
      gap: var(--esp-2);
      padding: var(--esp-2) var(--esp-3);
    }
    .topo__rotulo {
      display: none;
    }
    .marca :global(svg),
    .marca :global(.tarja) {
      height: 32px;
    }
  }
</style>
