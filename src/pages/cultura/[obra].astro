---
import Obra from '../../views/Obra.astro';
import { carregarObras } from '../../lib/carregar';
import { prefixar } from '../../lib/idioma';

export async function getStaticPaths() {
  const obras = await carregarObras('pt');
  const noOutro = new Set((await carregarObras('es')).map((o) => o.id));
  return obras.map((obra) => ({
    params: { obra: obra.id },
    props: {
      obra,
      alternativa: noOutro.has(obra.id)
        ? { href: prefixar(`/cultura/${obra.id}`, 'es'), equivalente: true }
        : { href: prefixar('/cultura', 'es'), equivalente: false },
    },
  }));
}
---
<Obra idioma="pt" {...Astro.props} />
