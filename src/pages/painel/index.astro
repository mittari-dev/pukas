---
// Estúdio (a fila do painel): criar nova peça (modal com o tipo), abas por estado, filtro por tipo.
import Painel from '../../layouts/Painel.astro';
import { listarFila } from '../../lib/banco/painel';
import { formatarNumero } from '../../lib/formato';
import { lerSeries } from '../../lib/banco/series';
import { nomeDaSerie } from '../../lib/series';
import { textoManchete } from '../../lib/manchete';
import type { EstadoPeca, TipoPeca } from '../../lib/painel/travas';

const ABAS: [EstadoPeca, string][] = [['rascunho', 'Rascunhos'], ['em_revisao', 'Em revisão'], ['publicada', 'Publicadas'], ['rejeitada', 'Rejeitadas']];
const TIPOS: [TipoPeca, string][] = [['newsletter', 'Newsletter'], ['noticia', 'Notícia'], ['materia', 'Matéria'], ['cultura', 'Cultura'], ['votacao', 'Votação'], ['pagina', 'Página']];
// Filtro de tipo sem "Página": o manifesto aparece em Todos; página nova não se cria pelo Estúdio.
const FILTROS = TIPOS.filter(([t]) => t !== 'pagina');

// Estado vazio: o que costuma aparecer em cada aba.
const VAZIO: Record<EstadoPeca, { titulo: string; texto: string }> = {
  rascunho: { titulo: 'Nenhum rascunho', texto: 'O que você começar e ainda não mandar para revisão fica guardado aqui.' },
  em_revisao: { titulo: 'Nada em revisão', texto: 'Peças enviadas para revisão esperam aqui até alguém aprovar.' },
  publicada: { titulo: 'Nada publicado', texto: 'O que estiver no ar aparece aqui. Para corrigir uma peça publicada, abra-a por aqui.' },
  rejeitada: { titulo: 'Nada rejeitado', texto: 'Peças rejeitadas ficam aqui. Dá para abrir, ajustar e retomar.' },
};
// Opções do modal: os tipos que o editor já aceita (/painel/peca/nova?tipo=...). "Página" fica de fora:
// o site só mostra a página "manifesto" (editável por Publicadas); página nova só com endereço criado junto.
const OPCOES: { tipo: TipoPeca; nome: string; texto: string }[] = [
  { tipo: 'newsletter', nome: 'Newsletter', texto: 'Edição de uma série (escolha abaixo): foto, fontes primárias e checagem.' },
  { tipo: 'noticia', nome: 'Notícia', texto: 'Fato do presente que pesa sobre a classe trabalhadora, com fontes.' },
  { tipo: 'materia', nome: 'Matéria', texto: 'Vídeo longo do YouTube (quinta ou dossiê do mês), com o texto e as fontes.' },
  { tipo: 'cultura', nome: 'Cultura', texto: 'Conto, cena, poema ou ensaio.' },
  { tipo: 'votacao', nome: 'Votação', texto: 'Pergunta à base sobre um PL, PLP ou PEC da Câmara ou do Senado.' },
];

const pedidoEstado = Astro.url.searchParams.get('estado');
const estado = (ABAS.find(([e]) => e === pedidoEstado)?.[0] ?? 'rascunho') as EstadoPeca;
const pedidoTipo = Astro.url.searchParams.get('tipo');
const tipo = TIPOS.find(([t]) => t === pedidoTipo)?.[0];
const [pecas, series] = await Promise.all([listarFila(Astro.locals.painel!.cliente, estado, tipo), lerSeries(Astro.locals.painel!.cliente)]);
const nomeSerie = (slug: string | null) => nomeDaSerie(series, slug);
const nomeTipo = Object.fromEntries(TIPOS);
const link = (e: EstadoPeca, t?: TipoPeca) => `/painel?estado=${e}${t ? `&tipo=${t}` : ''}`;
const quando = (s: string) => new Date(s).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' });
---
<Painel titulo="Estúdio">
  <header class="estudio__cabeca">
    <h1>Estúdio</h1>
    <a class="botao botao--marca estudio__criar" href="#nova-peca" data-abrir-nova>+ Criar nova peça</a>
  </header>

  <nav class="estados maquina" aria-label="Estado das peças">
    <ul>
      {ABAS.map(([e, nome]) => <li><a href={link(e, tipo)} aria-current={e === estado ? 'page' : undefined}>{nome}</a></li>)}
    </ul>
  </nav>

  <nav class="tipos maquina" aria-labelledby="tipos-rotulo">
    <span id="tipos-rotulo" class="tipos__rotulo">Tipo</span>
    <ul>
      <li><a href={link(estado)} aria-current={!tipo ? 'page' : undefined}>Todos</a></li>
      {FILTROS.map(([t, nome]) => <li><a href={link(estado, t)} aria-current={t === tipo ? 'page' : undefined}>{nome}</a></li>)}
    </ul>
  </nav>

  {pecas.length === 0 ? (
    <section class="vazio" aria-labelledby="vazio-titulo">
      <h2 id="vazio-titulo" class="vazio__titulo">{VAZIO[estado].titulo}{tipo ? ` · ${nomeTipo[tipo]}` : ''}</h2>
      <p>{VAZIO[estado].texto}</p>
      {estado === 'rascunho' && <a class="botao botao--linha estudio__criar" href="#nova-peca" data-abrir-nova>+ Criar nova peça</a>}
    </section>
  ) : (
    <ul class="fila">
      {pecas.map((p) => (
        <li>
          <a href={`/painel/peca/${p.id}`}>
            <span class="maquina fila__meta">
              {nomeTipo[p.tipo]}{nomeSerie(p.serie) ? ` · ${nomeSerie(p.serie)}` : ''}{p.numero !== null && p.tipo !== 'pagina' ? ` · ${formatarNumero(p.numero)}` : ''} · {quando(p.atualizado_em)}
            </span>
            <span class="fila__titulo">{textoManchete(p.titulo) || '(sem título)'}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  <!-- Escolha do tipo. Com JavaScript abre como modal (public/estudio.js); sem ele, o link #nova-peca mostra o bloco na página. -->
  <dialog id="nova-peca" class="nova" aria-labelledby="nova-titulo" aria-describedby="nova-sub">
    <form method="get" action="/painel/peca/nova">
      <h2 id="nova-titulo" class="nova__titulo">Nova peça</h2>
      <p id="nova-sub" class="nova__sub">O que você deseja criar?</p>
      <fieldset class="nova__opcoes">
        <legend class="sr-only">Tipo de peça</legend>
        {OPCOES.map((o, i) => (
          <label class="opcao">
            <input type="radio" name="tipo" value={o.tipo} required checked={i === 0} />
            <span class="opcao__nome">{o.nome}</span>
            <span class="opcao__texto">{o.texto}</span>
          </label>
        ))}
      </fieldset>
      <div class="campo nova__serie">
        <label for="nova-serie">Série da newsletter</label>
        <select id="nova-serie" name="serie">
          {series.filter((x) => x.ativa).map((x) => <option value={x.slug}>{x.nome}</option>)}
        </select>
      </div>
      <div class="nova__acoes">
        <a class="botao botao--linha" href="#" data-fechar-nova>Cancelar</a>
        <button class="botao botao--marca" type="submit">Continuar →</button>
      </div>
    </form>
  </dialog>
  <script is:inline src="/estudio.js" defer></script>
</Painel>

<style>
  /* Grade do Estúdio: a coluna do painel (760px); blocos separados por --esp-4 a --esp-6. */
  .estudio__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--esp-4);
    margin-bottom: var(--esp-6);
  }
  .estudio__cabeca h1 {
    margin: 0;
  }
  .estudio__criar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .botao:focus-visible,
  .estados a:focus-visible,
  .tipos a:focus-visible,
  .fila a:focus-visible,
  .opcao:has(input:focus-visible) {
    outline: 3px solid var(--pau-brasil);
    outline-offset: 2px;
  }

  /* Estado: navegação em abas numa linha; no celular rola para o lado em vez de quebrar. */
  .estados {
    border-bottom: 1px solid var(--tinta);
    margin-bottom: var(--esp-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .estados ul,
  .tipos ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .estados ul {
    gap: var(--esp-5);
    min-width: max-content;
  }
  .estados a {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-bottom: 4px solid transparent;
  }
  .estados [aria-current] {
    border-bottom-color: var(--pau-brasil);
    font-weight: 700;
  }

  /* Tipo: filtro, menor e com rótulo, para não parecer navegação. */
  .tipos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-2) var(--esp-3);
    margin-bottom: var(--esp-6);
    font-size: 12px;
  }
  .tipos__rotulo {
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tipos ul {
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .tipos a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--esp-3);
    border: 1px solid var(--tinta);
    text-decoration: none;
    color: inherit;
  }
  .tipos [aria-current] {
    background: var(--tinta);
    color: var(--cal);
  }

  /* Fila no mesmo padrão das listas do site: abre na linha grossa, fio fino entre as peças, sem linha sobrando no fim. */
  .fila {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--tinta);
  }
  .fila li + li {
    border-top: 1px solid var(--fio);
  }
  .fila a {
    display: grid;
    gap: var(--esp-2);
    padding: var(--esp-4) 0;
    text-decoration: none;
    color: inherit;
  }
  .fila a:hover .fila__titulo {
    color: var(--pau-brasil);
  }
  .fila__meta {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--suave);
  }
  .fila__titulo {
    font-weight: 700;
    font-size: clamp(18px, 4.5vw, 21px);
    line-height: 1.25;
  }

  .vazio {
    display: grid;
    justify-items: start;
    gap: var(--esp-3);
    padding: var(--esp-6) var(--esp-5);
    border: 1px dashed var(--tinta);
  }
  .vazio__titulo {
    font-family: var(--fonte-manchete);
    font-stretch: var(--largura-manchete);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 24px;
    line-height: 1;
    margin: 0;
  }
  .vazio p {
    margin: 0;
    max-width: 46ch;
  }

  /* Modal da nova peça. */
  .nova {
    width: min(560px, calc(100vw - 2 * var(--esp-4)));
    max-height: calc(100dvh - 2 * var(--esp-4));
    padding: var(--esp-5);
    border: 3px solid var(--tinta);
    background: var(--fundo);
    color: var(--texto);
  }
  .nova::backdrop {
    background: color-mix(in srgb, var(--tinta) 60%, transparent);
  }
  /* Sem JavaScript: o link #nova-peca mostra o bloco na própria página. */
  .nova:target:not([open]) {
    display: block;
    position: static;
    margin: var(--esp-6) 0 0;
  }
  .nova__titulo {
    font-family: var(--fonte-manchete);
    font-stretch: var(--largura-manchete);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 32px;
    line-height: 1;
    margin: 0;
  }
  .nova__sub {
    margin: var(--esp-2) 0 var(--esp-5);
  }
  .nova__opcoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--esp-3);
    border: 0;
    padding: 0;
    margin: 0 0 var(--esp-5);
  }
  .opcao {
    position: relative;
    display: grid;
    gap: var(--esp-1);
    padding: var(--esp-4);
    border: 1px solid var(--tinta);
    cursor: pointer;
  }
  .opcao input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opcao:hover {
    border-color: var(--pau-brasil);
  }
  .opcao:has(input:checked) {
    border: 3px solid var(--pau-brasil);
    padding: calc(var(--esp-4) - 2px);
  }
  .opcao:has(input:checked) .opcao__nome::before {
    content: '■ ';
    color: var(--pau-brasil);
  }
  .opcao__nome {
    font-family: var(--fonte-maquina);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .opcao__texto {
    font-size: 14px;
    line-height: 1.4;
  }
  /* A série só vale para newsletter: some quando outro tipo está marcado. */
  .nova__serie {
    margin: calc(-1 * var(--esp-2)) 0 var(--esp-5);
  }
  .nova:has(input[name='tipo']:not([value='newsletter']):checked) .nova__serie {
    display: none;
  }
  .nova__acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--esp-3);
  }
  .nova__acoes .botao {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .estudio__criar,
    .nova__acoes .botao {
      flex: 1 1 100%;
      justify-content: center;
    }
    .nova {
      padding: var(--esp-4);
    }
  }
</style>
