---
// Link de convite (gerado em /painel/equipe): a pessoa cria a senha aqui. O código do e-mail só é usado no POST,
// porque prévias de link (WhatsApp, antivírus) abrem o endereço sozinhas e queimariam o convite num GET.
import Painel from '../../layouts/Painel.astro';
import { lerSenhaNova } from '../../lib/painel/equipe';

const cliente = Astro.locals.painel!.cliente;
const token = Astro.url.searchParams.get('token_hash') ?? '';
let erro = token ? '' : 'Link de convite incompleto. Peça um convite novo.';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const senha = lerSenhaNova(form);
  if (!senha.ok) erro = senha.erro;
  else {
    const { error } = await cliente.auth.verifyOtp({ type: 'invite', token_hash: String(form.get('token_hash') ?? '') });
    if (error) erro = 'Este convite já foi usado ou venceu. Peça um convite novo.';
    else {
      const { error: e } = await cliente.auth.updateUser({ password: senha.valor });
      if (!e) return Astro.redirect('/painel/2fa', 303);
      erro = 'Não deu para guardar a senha. Tente de novo.';
    }
  }
}
---
<Painel titulo="Convite">
  <h1>Bem-vindo à equipe</h1>
  {erro && <p class="mensagem" role="alert">{erro}</p>}
  {token && (
    <form method="post">
      <input type="hidden" name="token_hash" value={token} />
      <p>Crie a sua senha. Depois você cadastra o aplicativo autenticador (2FA).</p>
      <div class="campo">
        <label for="senha">Senha (pelo menos 12 caracteres)</label>
        <input id="senha" name="senha" type="password" autocomplete="new-password" minlength="12" required />
      </div>
      <div class="campo">
        <label for="repetir">Repita a senha</label>
        <input id="repetir" name="repetir" type="password" autocomplete="new-password" minlength="12" required />
      </div>
      <button class="botao botao--marca" type="submit">Criar senha</button>
    </form>
  )}
</Painel>
