---
import Edicao from '../../../../views/Edicao.astro';
import { carregarEdicoes, pendente } from '../../../../lib/carregar';
import { caminhoEdicao } from '../../../../lib/formato';
import { acharEdicao } from '../../../../lib/rotas';
import { etiquetasDaPeca } from '../../../../lib/cache';

const edicoes = await carregarEdicoes('es', Astro.params.serie);
let i = acharEdicao(edicoes, Astro.params.serie, Astro.params.numero);
let edicao = edicoes[i];
if (i < 0) {
  // Sem tradução pronta: o original, com o aviso de tradução a caminho.
  const originais = await carregarEdicoes('pt', Astro.params.serie);
  const j = acharEdicao(originais, Astro.params.serie, Astro.params.numero);
  if (j < 0) return Astro.rewrite('/es/404');
  edicao = pendente(originais[j]);
}
Astro.locals.etiquetas = etiquetasDaPeca(edicao);
const alternativa = { href: caminhoEdicao(edicao.data.serie, edicao.data.numero, 'pt'), equivalente: true };
---
<Edicao idioma="es" edicao={edicao} seguinte={i >= 0 ? edicoes[i - 1] : undefined} anterior={i >= 0 ? edicoes[i + 1] : undefined} alternativa={alternativa} />
