---
import ArquivoSerie from '../../../../views/ArquivoSerie.astro';
import { carregarSeries } from '../../../../lib/carregar';

const serie = (await carregarSeries('es')).find((s) => s.slug === Astro.params.serie);
if (!serie) return Astro.rewrite('/es/404');
---
<ArquivoSerie idioma="es" serie={serie} />
