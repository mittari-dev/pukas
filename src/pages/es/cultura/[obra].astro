---
import Obra from '../../../views/Obra.astro';
import { carregarObras, pendente } from '../../../lib/carregar';
import { etiquetasDaPeca } from '../../../lib/cache';

let obra = (await carregarObras('es')).find((o) => o.id === Astro.params.obra);
if (!obra) {
  const original = (await carregarObras('pt')).find((o) => o.id === Astro.params.obra);
  if (!original) return Astro.rewrite('/es/404');
  obra = pendente(original);
}
Astro.locals.etiquetas = etiquetasDaPeca(obra);
---
<Obra idioma="es" obra={obra} alternativa={{ href: `/cultura/${obra.id}`, equivalente: true }} />
