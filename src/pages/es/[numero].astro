---
// Endereço curto impresso no carrossel (pukas.lat/es/001): redireciona para a edição completa.
import { carregarEdicoes } from '../../lib/carregar';
import { caminhoEdicao } from '../../lib/formato';
import { numeroDoEndereco } from '../../lib/rotas';

const edicao = (await carregarEdicoes('pt')).find((e) => numeroDoEndereco(e.data.numero) === Astro.params.numero);
if (!edicao) return Astro.rewrite('/es/404');
return Astro.redirect(caminhoEdicao(edicao.data.serie, edicao.data.numero, 'es'), 301);
---
