---
import Noticia from '../../../views/Noticia.astro';
import { carregarNoticias, pendente } from '../../../lib/carregar';
import { etiquetasDaPeca } from '../../../lib/cache';

let noticia = (await carregarNoticias('es')).find((n) => n.id === Astro.params.slug);
if (!noticia) {
  const original = (await carregarNoticias('pt')).find((n) => n.id === Astro.params.slug);
  if (!original) return Astro.rewrite('/es/404');
  noticia = pendente(original);
}
Astro.locals.etiquetas = etiquetasDaPeca(noticia);
---
<Noticia idioma="es" noticia={noticia} alternativa={{ href: `/noticias/${noticia.id}`, equivalente: true }} />
