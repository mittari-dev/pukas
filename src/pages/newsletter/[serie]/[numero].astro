---
import Edicao from '../../../views/Edicao.astro';
import { carregarEdicoes } from '../../../lib/carregar';
import { caminhoEdicao } from '../../../lib/formato';
import { prefixar } from '../../../lib/idioma';
import { acharEdicao } from '../../../lib/rotas';
import { etiquetaPeca } from '../../../lib/cache';

const edicoes = await carregarEdicoes('pt');
const i = acharEdicao(edicoes, Astro.params.serie, Astro.params.numero);
if (i < 0) return Astro.rewrite('/404');
const edicao = edicoes[i];
Astro.locals.etiquetas = [etiquetaPeca(edicao.id)];
const traduzida = (await carregarEdicoes('es')).some((e) => e.id === edicao.id);
// A lista vem do número maior para o menor: a seguinte é a de índice menor.
const alternativa = traduzida
  ? { href: caminhoEdicao(edicao.data.serie, edicao.data.numero, 'es'), equivalente: true }
  : { href: prefixar('/newsletter/memoria-operaria', 'es'), equivalente: false };
---
<Edicao idioma="pt" edicao={edicao} seguinte={edicoes[i - 1]} anterior={edicoes[i + 1]} alternativa={alternativa} />
